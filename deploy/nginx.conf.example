server {
    listen 80;
    listen [::]:80;
    server_name zonagris.viajeinteligencia.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name zonagris.viajeinteligencia.com;

    root /var/www/zonagris;
    index index.html;
    charset utf-8;

    ssl_certificate /etc/letsencrypt/live/zonagris.viajeinteligencia.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/zonagris.viajeinteligencia.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'" always;

    location / {
        try_files $uri $uri/ =404;
    }

    error_page 404 /404.html;
}
